<!DOCTYPE html>
<html lang="si">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Candy Crush</title>
<style>
  *{ box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body{
    margin:0; min-height:100vh;
    display:flex; align-items:center; justify-content:center;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: radial-gradient(circle at 30% 15%, #4b2a7a, #160d29 65%);
    color:#fff; padding:16px;
  }

  .game{
    width:min(94vw, 460px);
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 24px;
    padding: 16px;
    box-shadow: 0 24px 70px rgba(0,0,0,.55);
    position: relative;
  }

  h1{
    font-size: 1.1rem; text-align:center; margin:0 0 14px;
    letter-spacing: .5px; font-weight: 700;
    background: linear-gradient(90deg,#ffd166,#ff6b9d,#7bdff2);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .hud{
    display:flex; gap:8px; margin-bottom:12px;
    font-size:.82rem; font-weight:600;
  }
  .hud .box{
    flex:1; text-align:center;
    background: rgba(0,0,0,.28);
    padding:8px 6px; border-radius:14px;
    border:1px solid rgba(255,255,255,.08);
  }
  .hud .box span{ display:block; font-size:.65rem; opacity:.65; font-weight:400; margin-bottom:2px;}
  #restart{
    flex:0 0 auto; cursor:pointer;
    background: linear-gradient(180deg,#ff8a5c,#ef5b3f);
    border:none; color:#fff; font-weight:700; font-size:.8rem;
    padding:0 14px; border-radius:14px;
    transition: transform .12s;
  }
  #restart:active{ transform: scale(.94); }

  #grid{
    display:grid;
    grid-template-columns: repeat(8, 1fr);
    gap:4px;
    background: rgba(0,0,0,.28);
    padding:8px; border-radius:18px;
    touch-action: manipulation;
    user-select: none;
  }

  .cell{
    aspect-ratio: 1;
    display:flex; align-items:center; justify-content:center;
    font-size: clamp(15px, 4.4vw, 27px);
    line-height:1;
    background: rgba(255,255,255,.08);
    border-radius:10px;
    cursor:pointer;
    transition: transform .12s ease, background .12s ease;
  }
  .cell:hover{ background: rgba(255,255,255,.17); }
  .cell.sel{
    background: rgba(255,209,102,.9);
    transform: scale(1.1);
    box-shadow: 0 0 0 2px #fff inset, 0 0 14px rgba(255,209,102,.8);
  }
  .cell.pop{ animation: pop .24s ease forwards; }
  @keyframes pop{
    50%{ transform: scale(1.3); filter: brightness(1.7); }
    100%{ transform: scale(0); opacity:0; }
  }
  .cell.empty{ background: rgba(255,255,255,.02); }
  .cell.new{ animation: drop .2s ease; }
  @keyframes drop{ from{ transform: translateY(-14px); opacity:.2; } }

  .overlay{
    position:absolute; inset:0;
    background: rgba(10,6,20,.9);
    border-radius:24px;
    display:none; flex-direction:column;
    align-items:center; justify-content:center; gap:14px;
    text-align:center; padding:24px;
  }
  .overlay.show{ display:flex; }
  .overlay h2{ margin:0; font-size:1.5rem; }
  .overlay p{ margin:0; opacity:.8; font-size:.95rem; }
  .overlay button{
    margin-top:6px;
    background: linear-gradient(180deg,#7bdff2,#3aa8c9);
    border:none; color:#06202a; font-weight:800;
    padding:12px 28px; border-radius:999px; font-size:.95rem;
    cursor:pointer;
  }
  .overlay button:active{ transform: scale(.95); }
</style>
</head>
<body>

<div class="game">
  <h1>🍬 CANDY CRUSH 🍬</h1>

  <div class="hud">
    <div class="box"><span>SCORE</span><b id="score">0</b></div>
    <div class="box"><span>MOVES</span><b id="moves">25</b></div>
    <button id="restart">NEW</button>
  </div>

  <div id="grid"></div>

  <div class="overlay" id="overlay">
    <h2 id="ovTitle">Game Over!</h2>
    <p id="ovText"></p>
    <button id="ovBtn">Play Again</button>
  </div>
</div>

<script>
(() => {
  const ROWS = 8, COLS = 8;
  const TYPES = ['🍎','🍋','🍇','🍊','🫐','🍓'];
  const START_MOVES = 25;

  const gridEl   = document.getElementById('grid');
  const scoreEl  = document.getElementById('score');
  const movesEl  = document.getElementById('moves');
  const overlay  = document.getElementById('overlay');
  const ovTitle  = document.getElementById('ovTitle');
  const ovText   = document.getElementById('ovText');

  let board = [];
  let score = 0;
  let moves = START_MOVES;
  let selected = null;
  let busy = false;

  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const randType = () => TYPES[Math.floor(Math.random() * TYPES.length)];

  /* ---------- board setup ---------- */

  function createBoard(){
    board = [];
    for (let r = 0; r < ROWS; r++){
      board[r] = [];
      for (let c = 0; c < COLS; c++){
        let t;
        let guard = 0;
        do {
          t = randType();
          guard++;
        } while (guard < 50 && (
          (c >= 2 && board[r][c-1] === t && board[r][c-2] === t) ||
          (r >= 2 && board[r-1][c] === t && board[r-2][c] === t)
        ));
        board[r][c] = t;
      }
    }
  }

  /* ---------- match detection ---------- */

  function findMatches(){
    const matched = new Set();

    // horizontal
    for (let r = 0; r < ROWS; r++){
      let run = 1;
      for (let c = 1; c <= COLS; c++){
        if (c < COLS && board[r][c] && board[r][c] === board[r][c-1]){
          run++;
        } else {
          if (run >= 3) for (let k = c - run; k < c; k++) matched.add(r + ',' + k);
          run = 1;
        }
      }
    }

    // vertical
    for (let c = 0; c < COLS; c++){
      let run = 1;
      for (let r = 1; r <= ROWS; r++){
        if (r < ROWS && board[r][c] && board[r][c] === board[r-1][c]){
          run++;
        } else {
          if (run >= 3) for (let k = r - run; k < r; k++) matched.add(k + ',' + c);
          run = 1;
        }
      }
    }
    return matched;
  }

  /* ---------- rendering ---------- */

  function render(){
    const frag = document.createDocumentFragment();
    for (let r = 0; r < ROWS; r++){
      for (let c = 0; c < COLS; c++){
        const d = document.createElement('div');
        d.className = 'cell';
        d.dataset.r = r;
        d.dataset.c = c;
        const v = board[r][c];
        if (v === null || v === undefined){
          d.classList.add('empty');
        } else {
          d.textContent = v;
        }
        if (selected && selected.r === r && selected.c === c) d.classList.add('sel');
        frag.appendChild(d);
      }
    }
    gridEl.innerHTML = '';
    gridEl.appendChild(frag);
  }

  function cellEl(r, c){
    return gridEl.querySelector(`[data-r="${r}"][data-c="${c}"]`);
  }

  function updateHUD(){
    scoreEl.textContent = score;
    movesEl.textContent = moves;
  }

  /* ---------- swap & drop ---------- */

  function swapVals(r1, c1, r2, c2){
    const t = board[r1][c1];
    board[r1][c1] = board[r2][c2];
    board[r2][c2] = t;
  }

  function dropAndRefill(){
    for (let c = 0; c < COLS; c++){
      const stack = [];
      for (let r = ROWS - 1; r >= 0; r--){
        if (board[r][c]) stack.push(board[r][c]);
      }
      for (let r = ROWS - 1; r >= 0; r--){
        const idx = ROWS - 1 - r;
        board[r][c] = idx < stack.length ? stack[idx] : randType();
      }
    }
  }

  /* ---------- cascade resolution ---------- */

  async function resolve(){
    let combo = 0;

    while (true){
      const matched = findMatches();
      if (matched.size === 0) break;

      combo++;
      score += matched.size * 10 * combo;
      updateHUD();

      // pop animation
      matched.forEach(key => {
        const [r, c] = key.split(',').map(Number);
        const el = cellEl(r, c);
        if (el) el.classList.add('pop');
      });
      await sleep(240);

      matched.forEach(key => {
        const [r, c] = key.split(',').map(Number);
        board[r][c] = null;
      });
      render();
      await sleep(90);

      dropAndRefill();
      render();
      await sleep(180);
    }
  }

  /* ---------- player actions ---------- */

  async function trySwap(a, b){
    if (busy || moves <= 0) return;
    busy = true;
    selected = null;

    swapVals(a.r, a.c, b.r, b.c);
    render();
    await sleep(150);

    if (findMatches().size === 0){
      // invalid swap -> revert
      swapVals(a.r, a.c, b.r, b.c);
      render();
      const el = cellEl(b.r, b.c);
      if (el) el.animate(
        [{transform:'translateX(-4px)'},{transform:'translateX(4px)'},{transform:'translateX(0)'}],
        {duration:180}
      );
      await sleep(180);
      busy = false;
      return;
    }

    moves--;
    updateHUD();

    await resolve();
    await ensurePlayable();

    busy = false;
    if (moves <= 0) endGame();
  }

  function handleTap(r, c){
    if (busy || moves <= 0) return;

    if (!selected){
      selected = { r, c };
      render();
      return;
    }
    if (selected.r === r && selected.c === c){
      selected = null;
      render();
      return;
    }
    const dist = Math.abs(selected.r - r) + Math.abs(selected.c - c);
    if (dist === 1){
      const a = selected;
      selected = null;
      trySwap(a, { r, c });
    } else {
      selected = { r, c };
      render();
    }
  }

  /* ---------- deadlock check ---------- */

  function hasPossibleMove(){
    for (let r = 0; r < ROWS; r++){
      for (let c = 0; c < COLS; c++){
        if (c < COLS - 1){
          swapVals(r, c, r, c + 1);
          const ok = findMatches().size > 0;
          swapVals(r, c, r, c + 1);
          if (ok) return true;
        }
        if (r < ROWS - 1){
          swapVals(r, c, r + 1, c);
          const ok = findMatches().size > 0;
          swapVals(r, c, r + 1, c);
          if (ok) return true;
        }
      }
    }
    return false;
  }

  async function ensurePlayable(){
    let guard = 0;
    while (!hasPossibleMove() && guard++ < 25){
      for (let r = 0; r < ROWS; r++)
        for (let c = 0; c < COLS; c++)
          board[r][c] = randType();
      render();
      await sleep(160);
      await resolve();
    }
  }

  /* ---------- input (tap + swipe) ---------- */

  let downCell = null;

  gridEl.addEventListener('pointerdown', e => {
    const cell = e.target.closest('.cell');
    downCell = cell ? { r: +cell.dataset.r, c: +cell.dataset.c } : null;
  });

  gridEl.addEventListener('pointerup', e => {
    const cell = e.target.closest('.cell');
    if (!cell || !downCell){ downCell = null; return; }

    const r = +cell.dataset.r, c = +cell.dataset.c;
    const start = downCell;
    downCell = null;

    if (start.r === r && start.c === c){
      handleTap(r, c);
    } else if (Math.abs(start.r - r) + Math.abs(start.c - c) === 1){
      trySwap(start, { r, c });
    } else {
      handleTap(r, c);
    }
  });

  gridEl.addEventListener('pointercancel', () => { downCell = null; });

  /* ---------- game flow ---------- */

  function endGame(){
    ovTitle.textContent = 'Game Over!';
    ovText.textContent  = 'ඔබේ ලකුණු: ' + score;
    overlay.classList.add('show');
  }

  async function newGame(){
    overlay.classList.remove('show');
    score = 0;
    moves = START_MOVES;
    selected = null;
    busy = true;
    updateHUD();

    createBoard();
    render();
    await resolve();
    await ensurePlayable();

    busy = false;
  }

  document.getElementById('restart').addEventListener('click', newGame);
  document.getElementById('ovBtn').addEventListener('click', newGame);

  newGame();
})();
</script>
</body>
</html>